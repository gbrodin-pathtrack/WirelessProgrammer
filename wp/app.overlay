#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/pinctrl/nrf-pinctrl.h>

// Make uart20 the Zephyr console.
/ {
	chosen {
		zephyr,console = &uart20;
	};

// Pin configuration of the FEM.
	nrf_radio_fem: nrf21540 {
		compatible = "nordic,nrf21540-fem";
		tx-en-gpios = <&gpio1 11 GPIO_ACTIVE_HIGH>;
		rx-en-gpios = <&gpio1 12 GPIO_ACTIVE_HIGH>;
		ant-sel-gpios = <&gpio1 13 GPIO_ACTIVE_LOW>; // Nordic configures signal as logically inactive, so changing polarity pulls it high.
		mode-gpios = <&gpio1 14 GPIO_ACTIVE_HIGH>;
		// PDN intentionally not listed here since it is connected on port 2, which is not supported by FEM integration (leaving blank should allow manual configuration).
	};
};

&radio {
	fem = <&nrf_radio_fem>;
};

&uicr {
	nfct-pins-as-gpios;
};

// UART pinctrl.
&pinctrl {
	/delete-node/ uart20_default;
	/delete-node/ uart20_sleep;

	uart20_default: uart20_default {
		group1 {
			psels = <NRF_PSEL(UART_TX, 1, 2)>,
				<NRF_PSEL(UART_RX, 1, 3)>;
			bias-pull-up;
		};
	};

	uart20_sleep: uart20_sleep {
		group1 {
			psels = <NRF_PSEL(UART_TX, 1, 2)>,
				<NRF_PSEL(UART_RX, 1, 3)>;
			low-power-enable;
		};
	};
};

&uart20 {
	status = "okay";
	current-speed = <115200>;

	pinctrl-0 = <&uart20_default>;
	pinctrl-1 = <&uart20_sleep>;
	pinctrl-names = "default", "sleep";
};

// Remove aliases that reference GPIO nodes which are about to be deleted.
&{/aliases} {
	/delete-property/ led3;
	/delete-property/ sw0;
	/delete-property/ mcuboot-button0;
};
/delete-node/ &button0; // P1.13 is Push Button 0 so needs erasing.
/delete-node/ &led3; // P1.14 is Green LED 3 so needs erasing.

// Disable spi00 since the corresponding pins are used in ESB.
&spi00 {
	status = "disabled";
};
// Child node of spi00 relating specifically to P2.00 - not needed but good to be explicit.
&mx25r64 {
	status = "disabled";
};
