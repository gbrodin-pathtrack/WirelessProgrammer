# Writes git_revision.h for the wireless programmer, run with cmake -P:
#   SOURCE_DIR  the directory whose commit is used, only changes under it make the build dirty
#   OUTPUT      the header to write
# The header holds the commit hash sent to the host, and as comments the commit date and dirty state that
# package_release.cmake names the release hex after. It is only rewritten when they change, so an unchanged revision
# doesn't cause a rebuild.
cmake_minimum_required(VERSION 3.20)

foreach(required_var SOURCE_DIR OUTPUT)
    if(NOT DEFINED ${required_var} OR "${${required_var}}" STREQUAL "")
        message(FATAL_ERROR "${required_var} is required")
    endif()
endforeach()

find_package(Git REQUIRED)

function(run_git output_var)
    execute_process(
        COMMAND "${GIT_EXECUTABLE}" ${ARGN}
        WORKING_DIRECTORY "${SOURCE_DIR}"
        RESULT_VARIABLE git_rc
        OUTPUT_VARIABLE git_out
        ERROR_VARIABLE git_err
        OUTPUT_STRIP_TRAILING_WHITESPACE
    )
    if(NOT git_rc EQUAL 0)
        message(FATAL_ERROR "git ${ARGN} failed: ${git_err}")
    endif()
    set(${output_var} "${git_out}" PARENT_SCOPE)
endfunction()

# Taken from the full hash, as --short can return more than 8 characters
run_git(GIT_HASH rev-parse HEAD)
string(SUBSTRING "${GIT_HASH}" 0 8 GIT_HASH)
string(TOUPPER "${GIT_HASH}" GIT_HASH)

# Commit date as YYMMDD, from YYYY-MM-DD
run_git(GIT_COMMIT_DATE log -1 --format=%cs)
string(REPLACE "-" "" GIT_DATE "${GIT_COMMIT_DATE}")
string(SUBSTRING "${GIT_DATE}" 2 6 GIT_DATE)

run_git(GIT_STATUS status --porcelain -- .)
if("${GIT_STATUS}" STREQUAL "")
    set(GIT_DIRTY 0)
else()
    set(GIT_DIRTY 1)
endif()

set(HEADER_CONTENT "/* Generated by cmake/git_revision.cmake */
#define GIT_REVISION_HASH 0x${GIT_HASH}u

/* Read by cmake/package_release.cmake:
	GIT_DATE \"${GIT_DATE}\"
	GIT_DIRTY ${GIT_DIRTY}
*/
")

# Leaves the file untouched when the content is the same
file(CONFIGURE OUTPUT "${OUTPUT}" CONTENT "${HEADER_CONTENT}" @ONLY)
